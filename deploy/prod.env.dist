# Variables de production. Copier ce fichier en deploy/prod.env (jamais commité) et le remplir.
# build.ps1 les compile dans app/.env.local.php.

APP_SECRET=
DEFAULT_URI=https://example.com/semseeker

# Clé API Cohere ; plusieurs clés séparées par des virgules sont utilisées à tour de rôle.
COHERE_API_KEY=

# Éditeur du site, affiché dans les mentions légales.
LEGAL_PUBLISHER=
LEGAL_ADDRESS=
LEGAL_SIREN=
LEGAL_CONTACT=
