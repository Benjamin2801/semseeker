<svg class="icon{{ class is defined ? ' ' ~ class }}" viewBox="0 0 16 16" width="{{ size ?? 13 }}" height="{{ size ?? 13 }}" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    {%- if name == 'copy' -%}
        <rect x="5.5" y="5.5" width="8" height="8" rx="1.5"/><path d="M10.5 5.5v-2a1 1 0 0 0-1-1h-6a1 1 0 0 0-1 1v6a1 1 0 0 0 1 1h2"/>
    {%- elseif name == 'download' -%}
        <path d="M8 2.5v8m-3.5-3.5L8 10.5l3.5-3.5M3 13.5h10"/>
    {%- elseif name == 'sun' -%}
        <circle cx="8" cy="8" r="3"/><path d="M8 1.5v1.5M8 13v1.5M1.5 8H3M13 8h1.5M3.4 3.4l1.1 1.1M11.5 11.5l1.1 1.1M3.4 12.6l1.1-1.1M11.5 4.5l1.1-1.1"/>
    {%- elseif name == 'moon' -%}
        <path d="M13.5 9.5A5.5 5.5 0 0 1 6.5 2.5a5.5 5.5 0 1 0 7 7Z"/>
    {%- elseif name == 'clock' -%}
        <circle cx="8" cy="8" r="6"/><path d="M8 4.8V8l2.2 1.4"/>
    {%- elseif name == 'sources' -%}
        <ellipse cx="8" cy="4" rx="5" ry="1.8"/><path d="M3 4v8c0 1 2.2 1.8 5 1.8s5-.8 5-1.8V4M3 8c0 1 2.2 1.8 5 1.8s5-.8 5-1.8"/>
    {%- elseif name == 'list' -%}
        <path d="M6 4.5h7M6 8h7M6 11.5h7"/><circle cx="3.3" cy="4.5" r=".6"/><circle cx="3.3" cy="8" r=".6"/><circle cx="3.3" cy="11.5" r=".6"/>
    {%- elseif name == 'globe' -%}
        <circle cx="8" cy="8" r="6"/><path d="M2 8h12M8 2c1.8 1.7 2.6 3.7 2.6 6S9.8 12.3 8 14c-1.8-1.7-2.6-3.7-2.6-6S6.2 3.7 8 2Z"/>
    {%- elseif name == 'check' -%}
        <path d="m3.5 8.5 3 3 6-7"/>
    {%- elseif name == 'x' -%}
        <path d="m4.5 4.5 7 7m0-7-7 7"/>
    {%- elseif name == 'target' -%}
        <circle cx="8" cy="8" r="6"/><circle cx="8" cy="8" r="3"/><circle cx="8" cy="8" r="0.6"/>
    {%- elseif name == 'tag' -%}
        <path d="M2.5 8.2V3a.5.5 0 0 1 .5-.5h5.2l5.3 5.3a1 1 0 0 1 0 1.4l-4.1 4.1a1 1 0 0 1-1.4 0Z"/><circle cx="5.5" cy="5.5" r="1"/>
    {%- elseif name == 'layers' -%}
        <path d="m8 2.5 5.5 3L8 8.5 2.5 5.5Z"/><path d="m2.5 8.5 5.5 3 5.5-3"/><path d="m2.5 11 5.5 3 5.5-3"/>
    {%- elseif name == 'link' -%}
        <path d="M6.8 9.2a2.5 2.5 0 0 0 3.6 0l2.3-2.3a2.5 2.5 0 0 0-3.6-3.6l-.9.9"/><path d="M9.2 6.8a2.5 2.5 0 0 0-3.6 0L3.3 9.1a2.5 2.5 0 0 0 3.6 3.6l.9-.9"/>
    {%- elseif name == 'star' -%}
        <path d="m8 2 1.8 3.8 4.2.5-3.1 2.9.8 4.1L8 11.3 4.3 13.3l.8-4.1L2 6.3l4.2-.5Z"/>
    {%- elseif name == 'help' -%}
        <circle cx="8" cy="8" r="6"/><path d="M6.3 6.2a1.8 1.8 0 1 1 2.5 1.7c-.5.2-.8.6-.8 1.1v.4"/><path d="M8 11.3v.1"/>
    {%- endif -%}
</svg>
